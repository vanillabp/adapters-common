<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>quarkus-integration-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <groupId>io.vanillabp.quarkus</groupId>
  <artifactId>integration-tests-parent</artifactId>
  <packaging>pom</packaging>
  <name>Quarkus integration - Integration tests parent</name>

  <modules>
    <module>dummy-extension</module>
    <module>deployment-integration-tests</module>
    <module>test-applications</module>
    <module>main-integration-test</module>
    <module>workflowmodule-integration-tests</module>
    <module>processservice-integration-tests</module>
    <module>outbox-integration-tests</module>
    <module>outbox-mongo-integration-tests</module>
    <module>native-image-tests</module>
  </modules>

  <properties>
    <!-- test-only modules: nothing to publish. The BPMS double these tests run against is
         NOT one of them: it is published and lives in 'bpms-double', because the platform
         proves it for outsiders by using it itself - see decision 33 in the repository's
         DECISIONS.md. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.vanillabp</groupId>
        <artifactId>test-utils</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- run integration tests in every sub-module -->
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
