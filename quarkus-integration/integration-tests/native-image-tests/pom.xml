<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp.quarkus</groupId>
    <artifactId>integration-tests-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>native-image-tests</artifactId>
  <name>Quarkus integration - Integration tests - Native image</name>
  <description>An application with a relational database and no MongoDB anywhere, built as a native image. The build is one half of the test: GraalVM resolves every referenced method while it builds, so a reference to an optional extension nobody asked for ends it. The binary is the other half: it reads the configuration its two workflow modules ship, out of the image and not off a classpath, and its exit code says whether the profile it was started with picked the right file.</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-quarkus-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>bpms-double-quarkus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- a workflow module packaged as its own Maven module: its configuration files live
         in a dependency JAR, which is where an image has to pick them up from -->
    <dependency>
      <groupId>io.vanillabp.quarkus</groupId>
      <artifactId>application-with-workflow-module-config-in-a-jar</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-config-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-agroal</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- augmenting this application is the test: in JVM mode on every build, as a
           native image where the profile 'native-image' is active -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native-image</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <!-- no GraalVM has to be installed: the builder image brings one. Override
             with -Dquarkus.native.container-build=false where one is at hand -->
        <quarkus.native.container-build>true</quarkus.native.container-build>
      </properties>
    </profile>
  </profiles>
</project>
