<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>adapter-platform-integration</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkus-integration-parent</artifactId>
  <packaging>pom</packaging>
  <name>Quarkus Integration</name>
  <description>Aggregator of the VanillaBP Quarkus extension and its integration tests.</description>

  <modules>
    <module>quarkus-support</module>
    <module>deployment</module>
    <module>runtime</module>
    <module>integration-tests</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- The tests here boot their application IN this JVM, and Quarkus logs that
                 boot into a log context of its own: it happens in the Quarkus extension's
                 beforeAll, after this extension's and before its first beforeEach, so
                 nothing captures it. Measured on deployment-integration-tests: 311 lines
                 in a GREEN run of 35 tests. Hence the file - and the workflow uploads
                 these reports when a build fails, so the full log of a red run is one
                 download away instead of the last line Surefire prints. -->
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
            <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <!-- INFO and not ERROR: what a level drops reaches no handler, so it never
                   reaches the capture either and a failing class replays nothing worth
                   reading. -->
              <quarkus.log.level>INFO</quarkus.log.level>
              <maven.home>${maven.home}</maven.home>
              <maven.repo>${settings.localRepository}</maven.repo>
              <!--suppress UnresolvedMavenProperty - filled by goal jacoco-maven-plugin:prepare-agent in root pom.xml -->
              <!-- passed to quarkus prod tests for tracking of coverage -->
              <jacoco.agent>${jacoco.agent}</jacoco.agent>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
              <maven.repo>${settings.localRepository}</maven.repo>
              <!--suppress UnresolvedMavenProperty -->
              <!-- passed to quarkus prod tests for tracking of coverage -->
              <jacoco.agent>${jacoco.agent}</jacoco.agent>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <!-- necessary for serialization by Quarkus recorders -->
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
